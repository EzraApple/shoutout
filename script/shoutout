#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
binary="$root/apps/macos/dist/ShoutOut.app/Contents/MacOS/ShoutOut"
if [[ ! -x "$binary" ]]; then
    echo "Build the local app first: cd apps/macos && UNIVERSAL=false SKIP_NOTARIZE=true ./scripts/build-app.sh" >&2
    exit 1
fi
exec "$binary" --cli "$@"
